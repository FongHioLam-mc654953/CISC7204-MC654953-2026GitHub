# show the first 5 rows using dataframe.head() method
print("The first 5 rows of the dataframe") 
df.head(5)





lm = LinearRegression()

X = df[['CPU_frequency']]
Y = df['Price']

lm.fit(X,Y)

Yhat = lm.predict(X)









ax1 = sns.distplot(df['Price'], hist=False, color="r", label="Actual Value")

